# Normalize line endings so the repo behaves the same on Windows,
# Linux, and Mac. Without this, a Linux tool reading a Windows
# checkout sees every line as "changed" (CRLF vs LF). This stops that.

# Auto-detect text vs binary; normalize text on commit.
* text=auto

# Pin source + doc files to LF in the repo (checked out as native on Windows).
*.py    text
*.js    text
*.html  text
*.css   text
*.md    text
*.txt   text
*.json  text
*.spec  text
*.bat   text eol=crlf

# Treat these as binary — never touch their bytes.
*.db    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary
